@page "/ThuongHieu"
@using ThuongHieuModel = Data.Models.ThuongHieu
@using BlazorAdmin.IServices
@using Microsoft.AspNetCore.Components.Forms
@inject IThuongHieuService ThuongHieuService
@inject IJSRuntime JS

<PageTitle>Quản lý thương hiệu</PageTitle>

<div class="container py-4">
    <h3 class="mb-4">Quản lý thương hiệu</h3>

    @if (!string.IsNullOrWhiteSpace(thongBao))
    {
        <div class="alert @(laLoi ? "alert-danger" : "alert-success")">
            @thongBao
        </div>
    }

    <div class="card mb-4">
        <div class="card-header">
            <strong>@(dangSua ? "Cập nhật thương hiệu" : "Thêm thương hiệu mới")</strong>
        </div>
        <div class="card-body">
            <EditForm Model="@thuongHieuDangNhap" OnValidSubmit="@LuuThuongHieu">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Tên thương hiệu</label>
                        <InputText class="form-control"
                                   @bind-Value="thuongHieuDangNhap.TenThuongHieu" />
                        <ValidationMessage For="@(() => thuongHieuDangNhap.TenThuongHieu)" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Email</label>
                        <InputText class="form-control"
                                   @bind-Value="thuongHieuDangNhap.Email" />
                        <ValidationMessage For="@(() => thuongHieuDangNhap.Email)" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Số điện thoại</label>
                        <InputText class="form-control"
                                   @bind-Value="thuongHieuDangNhap.SDT" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Địa chỉ</label>
                        <InputText class="form-control"
                                   @bind-Value="thuongHieuDangNhap.DiaChi" />
                    </div>

                    <div class="col-md-12">
                        <label class="form-label">Mô tả</label>
                        <InputTextArea class="form-control"
                                       @bind-Value="thuongHieuDangNhap.MoTa" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Trạng thái</label>
                        <div class="form-check mt-2">
                            <InputCheckbox class="form-check-input"
                                           @bind-Value="thuongHieuDangNhap.TrangThai" />
                            <label class="form-check-label">
                                @(thuongHieuDangNhap.TrangThai ? "Đang hoạt động" : "Ngừng hoạt động")
                            </label>
                        </div>
                    </div>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-primary" disabled="@dangXuLy">
                        @(dangXuLy ? "Đang xử lý..." : dangSua ? "Cập nhật" : "Thêm mới")
                    </button>
                    <button type="button" class="btn btn-secondary ms-2" @onclick="LamMoiForm">
                        Làm mới
                    </button>
                </div>
            </EditForm>
        </div>
    </div>

    @if (thuongHieuChiTiet != null)
    {
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Chi tiết thương hiệu</strong>
                <button type="button" class="btn btn-sm btn-outline-secondary"
                        @onclick="DongChiTiet">
                    Đóng
                </button>
            </div>
            <div class="card-body">
                <p><strong>Mã thương hiệu:</strong> @thuongHieuChiTiet.ThuongHieuId</p>
                <p><strong>Tên thương hiệu:</strong> @thuongHieuChiTiet.TenThuongHieu</p>
                <p><strong>Email:</strong> @thuongHieuChiTiet.Email</p>
                <p><strong>Số điện thoại:</strong> @thuongHieuChiTiet.SDT</p>
                <p><strong>Địa chỉ:</strong> @thuongHieuChiTiet.DiaChi</p>
                <p><strong>Mô tả:</strong> @thuongHieuChiTiet.MoTa</p>
                <p>
                    <strong>Trạng thái:</strong>
                    @(thuongHieuChiTiet.TrangThai ? "Đang hoạt động" : "Ngừng hoạt động")
                </p>
            </div>
        </div>
    }

    <div class="card">
        <div class="card-header">
            <strong>Danh sách thương hiệu</strong>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-6">
                    <input class="form-control"
                           placeholder="Nhập tên thương hiệu cần tìm..."
                           @bind="tuKhoa" @bind:event="oninput" />
                </div>
                <div class="col-md-6 mt-2 mt-md-0 text-md-end">
                    <span>Tổng số: @DanhSachHienThi.Count() thương hiệu</span>
                </div>
            </div>

            @if (dangTai)
            {
                <p>Đang tải danh sách thương hiệu...</p>
            }
            else if (!DanhSachHienThi.Any())
            {
                <p class="text-muted">Không tìm thấy thương hiệu nào.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>STT</th>
                                <th>Mã thương hiệu</th>
                                <th>Tên thương hiệu</th>
                                <th>Email</th>
                                <th>Số điện thoại</th>
                                <th>Trạng thái</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in DanhSachHienThi)
                            {
                                <tr @key="item.ThuongHieuId">
                                    <td>@(DanhSachHienThi.ToList().IndexOf(item) + 1)</td>
                                    <td>@item.ThuongHieuId</td>
                                    <td>@item.TenThuongHieu</td>
                                    <td>@item.Email</td>
                                    <td>@item.SDT</td>
                                    <td>
                                        @if (item.TrangThai)
                                        {
                                            <span class="badge bg-success">Đang hoạt động</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Ngừng hoạt động</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-1">
                                            <button type="button" class="btn btn-info btn-sm"
                                                    @onclick="() => XemChiTiet(item.ThuongHieuId)">
                                                Chi tiết
                                            </button>
                                            <button type="button" class="btn btn-warning btn-sm"
                                                    @onclick="() => SuaThuongHieu(item.ThuongHieuId)">
                                                Sửa
                                            </button>
                                            <button type="button" class="btn btn-danger btn-sm"
                                                    @onclick="() => XoaThuongHieu(item.ThuongHieuId)">
                                                Xóa
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<ThuongHieuModel> danhSachThuongHieu = new();
    private ThuongHieuModel thuongHieuDangNhap = TaoThuongHieuMoi();
    private ThuongHieuModel? thuongHieuChiTiet;

    private string tuKhoa = string.Empty;
    private string thongBao = string.Empty;

    private bool dangTai = true;
    private bool dangSua;
    private bool dangXuLy;
    private bool laLoi;

    private IEnumerable<ThuongHieuModel> DanhSachHienThi =>
        danhSachThuongHieu.Where(x =>
            string.IsNullOrWhiteSpace(tuKhoa) ||
            (x.TenThuongHieu?.Contains(
                tuKhoa.Trim(), StringComparison.OrdinalIgnoreCase) ?? false));

    private static ThuongHieuModel TaoThuongHieuMoi() => new()
    {
        TenThuongHieu = string.Empty,
        Email = string.Empty,
        SDT = string.Empty,
        DiaChi = string.Empty,
        MoTa = string.Empty,
        TrangThai = true
    };

    protected override async Task OnInitializedAsync()
    {
        await TaiDanhSach();
    }

    private async Task TaiDanhSach()
    {
        dangTai = true;

        try
        {
            danhSachThuongHieu = await ThuongHieuService.GetAllAsync();
        }
        catch (Exception ex)
        {
            BaoLoi($"Không tải được danh sách thương hiệu: {ex.Message}");
        }
        finally
        {
            dangTai = false;
        }
    }

    private async Task LuuThuongHieu()
    {
        if (dangXuLy) return;

        dangXuLy = true;
        thongBao = string.Empty;

        try
        {
            bool thanhCong;

            if (dangSua)
            {
                thanhCong = await ThuongHieuService.UpdateAsync(
                    thuongHieuDangNhap.ThuongHieuId, thuongHieuDangNhap);

                if (!thanhCong)
                {
                    BaoLoi("Cập nhật thất bại hoặc không tìm thấy thương hiệu.");
                    return;
                }

                BaoThanhCong("Cập nhật thương hiệu thành công.");
            }
            else
            {
                thanhCong = await ThuongHieuService.CreateAsync(thuongHieuDangNhap);

                if (!thanhCong)
                {
                    BaoLoi("Thêm thương hiệu thất bại. Vui lòng kiểm tra dữ liệu.");
                    return;
                }

                BaoThanhCong("Thêm thương hiệu thành công.");
            }

            LamMoiForm();
            await TaiDanhSach();
        }
        catch (Exception ex)
        {
            BaoLoi($"Có lỗi khi lưu thương hiệu: {ex.Message}");
        }
        finally
        {
            dangXuLy = false;
        }
    }

    private async Task SuaThuongHieu(Guid id)
    {
        try
        {
            var item = await ThuongHieuService.GetByIdAsync(id);

            if (item == null)
            {
                BaoLoi("Không tìm thấy thương hiệu cần sửa.");
                return;
            }

            thuongHieuDangNhap = new ThuongHieuModel
            {
                ThuongHieuId = item.ThuongHieuId,
                TenThuongHieu = item.TenThuongHieu,
                Email = item.Email,
                SDT = item.SDT,
                DiaChi = item.DiaChi,
                MoTa = item.MoTa,
                TrangThai = item.TrangThai
            };

            dangSua = true;
            thuongHieuChiTiet = null;
            thongBao = string.Empty;
        }
        catch (Exception ex)
        {
            BaoLoi($"Không tải được thông tin thương hiệu: {ex.Message}");
        }
    }

    private async Task XemChiTiet(Guid id)
    {
        try
        {
            thuongHieuChiTiet = await ThuongHieuService.GetByIdAsync(id);

            if (thuongHieuChiTiet == null)
                BaoLoi("Không tìm thấy thông tin thương hiệu.");
        }
        catch (Exception ex)
        {
            BaoLoi($"Không xem được chi tiết thương hiệu: {ex.Message}");
        }
    }

    private async Task XoaThuongHieu(Guid id)
    {
        bool xacNhan = await JS.InvokeAsync<bool>(
            "confirm", "Bạn có chắc chắn muốn xóa thương hiệu này không?");

        if (!xacNhan) return;

        try
        {
            bool thanhCong = await ThuongHieuService.DeleteAsync(id);

            if (!thanhCong)
            {
                BaoLoi("Xóa thất bại. Có thể thương hiệu đang được sử dụng.");
                return;
            }

            if (thuongHieuChiTiet?.ThuongHieuId == id)
                thuongHieuChiTiet = null;

            BaoThanhCong("Xóa thương hiệu thành công.");
            await TaiDanhSach();
        }
        catch (Exception ex)
        {
            BaoLoi($"Không xóa được thương hiệu: {ex.Message}");
        }
    }

    private void LamMoiForm()
    {
        thuongHieuDangNhap = TaoThuongHieuMoi();
        dangSua = false;
        thongBao = string.Empty;
    }

    private void DongChiTiet()
    {
        thuongHieuChiTiet = null;
    }

    private void BaoThanhCong(string noiDung)
    {
        thongBao = noiDung;
        laLoi = false;
    }

    private void BaoLoi(string noiDung)
    {
        thongBao = noiDung;
        laLoi = true;
    }
}