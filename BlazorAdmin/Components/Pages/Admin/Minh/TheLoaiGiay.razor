@page "/TheLoaiGiay"
@using TheLoaiGiayModel = Data.Models.TheLoaiGiay
@using BlazorAdmin.IServices
@using Microsoft.AspNetCore.Components.Forms
@inject ITheLoaiGiayService TheLoaiGiayService
@inject IJSRuntime JS

<PageTitle>Quản lý thể loại giày</PageTitle>

<div class="container py-4">
    <h3 class="mb-4">Quản lý thể loại giày</h3>

    @if (!string.IsNullOrWhiteSpace(thongBao))
    {
        <div class="alert @(laLoi ? "alert-danger" : "alert-success")">
            @thongBao
        </div>
    }

    <div class="card mb-4">
        <div class="card-header">
            <strong>@(dangSua ? "Cập nhật thể loại giày" : "Thêm thể loại giày mới")</strong>
        </div>
        <div class="card-body">
            <EditForm Model="@theLoaiDangNhap" OnValidSubmit="@LuuTheLoai">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Tên thể loại</label>
                        <InputText class="form-control"
                                   @bind-Value="theLoaiDangNhap.TenTheLoai" />
                        <ValidationMessage For="@(() => theLoaiDangNhap.TenTheLoai)" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Trạng thái</label>
                        <div class="form-check mt-2">
                            <InputCheckbox class="form-check-input"
                                           @bind-Value="theLoaiDangNhap.TrangThai" />
                            <label class="form-check-label">
                                @(theLoaiDangNhap.TrangThai ? "Đang hoạt động" : "Ngừng hoạt động")
                            </label>
                        </div>
                    </div>

                    <div class="col-md-12">
                        <label class="form-label">Mô tả</label>
                        <InputTextArea class="form-control"
                                       @bind-Value="theLoaiDangNhap.MoTa" />
                    </div>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-primary" disabled="@dangXuLy">
                        @(dangXuLy ? "Đang xử lý..." : dangSua ? "Cập nhật" : "Thêm mới")
                    </button>
                    <button type="button" class="btn btn-secondary ms-2" @onclick="LamMoiForm">
                        Làm mới
                    </button>
                </div>
            </EditForm>
        </div>
    </div>

    @if (theLoaiChiTiet != null)
    {
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Chi tiết thể loại giày</strong>
                <button type="button" class="btn btn-sm btn-outline-secondary"
                        @onclick="DongChiTiet">
                    Đóng
                </button>
            </div>
            <div class="card-body">
                <p><strong>Mã thể loại:</strong> @theLoaiChiTiet.TheLoaiGiayId</p>
                <p><strong>Tên thể loại:</strong> @theLoaiChiTiet.TenTheLoai</p>
                <p><strong>Mô tả:</strong> @theLoaiChiTiet.MoTa</p>
                <p>
                    <strong>Trạng thái:</strong>
                    @(theLoaiChiTiet.TrangThai ? "Đang hoạt động" : "Ngừng hoạt động")
                </p>
            </div>
        </div>
    }

    <div class="card">
        <div class="card-header">
            <strong>Danh sách thể loại giày</strong>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-6">
                    <input class="form-control"
                           placeholder="Nhập tên thể loại cần tìm..."
                           @bind="tuKhoa" @bind:event="oninput" />
                </div>
                <div class="col-md-6 mt-2 mt-md-0 text-md-end">
                    <span>Tổng số: @DanhSachHienThi.Count() thể loại</span>
                </div>
            </div>

            @if (dangTai)
            {
                <p>Đang tải danh sách thể loại giày...</p>
            }
            else if (!DanhSachHienThi.Any())
            {
                <p class="text-muted">Không tìm thấy thể loại giày nào.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>STT</th>
                                <th>Mã thể loại</th>
                                <th>Tên thể loại</th>
                                <th>Mô tả</th>
                                <th>Trạng thái</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in DanhSachHienThi)
                            {
                                <tr @key="item.TheLoaiGiayId">
                                    <td>@(DanhSachHienThi.ToList().IndexOf(item) + 1)</td>
                                    <td>@item.TheLoaiGiayId</td>
                                    <td>@item.TenTheLoai</td>
                                    <td>@item.MoTa</td>
                                    <td>
                                        @if (item.TrangThai)
                                        {
                                            <span class="badge bg-success">Đang hoạt động</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Ngừng hoạt động</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-1">
                                            <button type="button" class="btn btn-info btn-sm"
                                                    @onclick="() => XemChiTiet(item.TheLoaiGiayId)">
                                                Chi tiết
                                            </button>
                                            <button type="button" class="btn btn-warning btn-sm"
                                                    @onclick="() => SuaTheLoai(item.TheLoaiGiayId)">
                                                Sửa
                                            </button>
                                            <button type="button" class="btn btn-danger btn-sm"
                                                    @onclick="() => XoaTheLoai(item.TheLoaiGiayId)">
                                                Xóa
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<TheLoaiGiayModel> danhSachTheLoai = new();
    private TheLoaiGiayModel theLoaiDangNhap = TaoTheLoaiMoi();
    private TheLoaiGiayModel? theLoaiChiTiet;

    private string tuKhoa = string.Empty;
    private string thongBao = string.Empty;

    private bool dangTai = true;
    private bool dangSua;
    private bool dangXuLy;
    private bool laLoi;

    private IEnumerable<TheLoaiGiayModel> DanhSachHienThi =>
        danhSachTheLoai.Where(x =>
            string.IsNullOrWhiteSpace(tuKhoa) ||
            (x.TenTheLoai?.Contains(
                tuKhoa.Trim(), StringComparison.OrdinalIgnoreCase) ?? false));

    private static TheLoaiGiayModel TaoTheLoaiMoi() => new()
    {
        TenTheLoai = string.Empty,
        MoTa = string.Empty,
        TrangThai = true
    };

    protected override async Task OnInitializedAsync()
    {
        await TaiDanhSach();
    }

    private async Task TaiDanhSach()
    {
        dangTai = true;

        try
        {
            danhSachTheLoai = await TheLoaiGiayService.GetAllAsync();
        }
        catch (Exception ex)
        {
            BaoLoi($"Không tải được danh sách thể loại giày: {ex.Message}");
        }
        finally
        {
            dangTai = false;
        }
    }

    private async Task LuuTheLoai()
    {
        if (dangXuLy) return;

        dangXuLy = true;
        thongBao = string.Empty;

        try
        {
            bool thanhCong;

            if (dangSua)
            {
                thanhCong = await TheLoaiGiayService.UpdateAsync(
                    theLoaiDangNhap.TheLoaiGiayId, theLoaiDangNhap);

                if (!thanhCong)
                {
                    BaoLoi("Cập nhật thất bại hoặc không tìm thấy thể loại giày.");
                    return;
                }

                BaoThanhCong("Cập nhật thể loại giày thành công.");
            }
            else
            {
                thanhCong = await TheLoaiGiayService.CreateAsync(theLoaiDangNhap);

                if (!thanhCong)
                {
                    BaoLoi("Thêm thể loại giày thất bại. Vui lòng kiểm tra dữ liệu.");
                    return;
                }

                BaoThanhCong("Thêm thể loại giày thành công.");
            }

            LamMoiForm();
            await TaiDanhSach();
        }
        catch (Exception ex)
        {
            BaoLoi($"Có lỗi khi lưu thể loại giày: {ex.Message}");
        }
        finally
        {
            dangXuLy = false;
        }
    }

    private async Task SuaTheLoai(Guid id)
    {
        try
        {
            var item = await TheLoaiGiayService.GetByIdAsync(id);

            if (item == null)
            {
                BaoLoi("Không tìm thấy thể loại giày cần sửa.");
                return;
            }

            theLoaiDangNhap = new TheLoaiGiayModel
            {
                TheLoaiGiayId = item.TheLoaiGiayId,
                TenTheLoai = item.TenTheLoai,
                MoTa = item.MoTa,
                TrangThai = item.TrangThai
            };

            dangSua = true;
            theLoaiChiTiet = null;
            thongBao = string.Empty;
        }
        catch (Exception ex)
        {
            BaoLoi($"Không tải được thông tin thể loại giày: {ex.Message}");
        }
    }

    private async Task XemChiTiet(Guid id)
    {
        try
        {
            theLoaiChiTiet = await TheLoaiGiayService.GetByIdAsync(id);

            if (theLoaiChiTiet == null)
                BaoLoi("Không tìm thấy thông tin thể loại giày.");
        }
        catch (Exception ex)
        {
            BaoLoi($"Không xem được chi tiết thể loại giày: {ex.Message}");
        }
    }

    private async Task XoaTheLoai(Guid id)
    {
        bool xacNhan = await JS.InvokeAsync<bool>(
            "confirm", "Bạn có chắc chắn muốn xóa thể loại giày này không?");

        if (!xacNhan) return;

        try
        {
            bool thanhCong = await TheLoaiGiayService.DeleteAsync(id);

            if (!thanhCong)
            {
                BaoLoi("Xóa thất bại. Có thể thể loại giày đang được sử dụng.");
                return;
            }

            if (theLoaiChiTiet?.TheLoaiGiayId == id)
                theLoaiChiTiet = null;

            BaoThanhCong("Xóa thể loại giày thành công.");
            await TaiDanhSach();
        }
        catch (Exception ex)
        {
            BaoLoi($"Không xóa được thể loại giày: {ex.Message}");
        }
    }

    private void LamMoiForm()
    {
        theLoaiDangNhap = TaoTheLoaiMoi();
        dangSua = false;
        thongBao = string.Empty;
    }

    private void DongChiTiet()
    {
        theLoaiChiTiet = null;
    }

    private void BaoThanhCong(string noiDung)
    {
        thongBao = noiDung;
        laLoi = false;
    }

    private void BaoLoi(string noiDung)
    {
        thongBao = noiDung;
        laLoi = true;
    }
}