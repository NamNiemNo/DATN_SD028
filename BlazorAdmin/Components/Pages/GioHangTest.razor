@page "/test-gio-hang"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using System.Text
@using System.Text.Json
@inject HttpClient Http

<PageTitle>Test API Giỏ hàng</PageTitle>

<h1 class="mb-1">Test API Giỏ hàng</h1>
<p class="text-muted">Giao diện kiểm thử API giỏ hàng và chi tiết giỏ hàng. API base URL: <code>@Http.BaseAddress</code></p>

@if (!string.IsNullOrWhiteSpace(StatusMessage))
{
    <div class="alert @(IsError ? "alert-danger" : "alert-success")" role="alert">@StatusMessage</div>
}

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-bold">1. Tra cứu giỏ hàng</div>
            <div class="card-body">
                <label class="form-label">KhachHangId (GUID)</label>
                <input class="form-control mb-3" @bind="KhachHangId" placeholder="Nhập GUID khách hàng" />
                <div class="d-flex flex-wrap gap-2 mb-3">
                    <button class="btn btn-primary" @onclick="LoadCartByCustomer">Xem giỏ hàng khách này</button>
                    <button class="btn btn-outline-primary" @onclick="LoadAllCarts">GET danh sách giỏ hàng</button>
                </div>
                <label class="form-label">GioHangId (GUID)</label>
                <input class="form-control mb-3" @bind="GioHangId" placeholder="Nhập GUID giỏ hàng nếu API cần" />
                <button class="btn btn-outline-secondary" @onclick="LoadCartDetails">Tải chi tiết theo giỏ hàng</button>
                <p class="small text-muted mt-3 mb-0">Các đường dẫn đang cấu hình theo API đã trao đổi: <code>/api/GioHangs/khach-hang/{id}</code>, <code>/api/GioHangs/GetAllGioHang</code>.</p>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-bold">2. Thêm sản phẩm vào giỏ</div>
            <div class="card-body">
                <label class="form-label">KhachHangId (GUID)</label>
                <input class="form-control mb-2" @bind="AddCustomerId" placeholder="GUID khách hàng" />
                <label class="form-label">GiayChiTietId (GUID)</label>
                <input class="form-control mb-2" @bind="GiayChiTietId" placeholder="GUID biến thể giày còn hàng" />
                <label class="form-label">Số lượng</label>
                <input class="form-control mb-3" type="number" min="1" @bind="AddQuantity" />
                <button class="btn btn-success" @onclick="AddToCart">POST thêm vào giỏ</button>
                <p class="small text-muted mt-3 mb-0">Body mặc định gửi <code>KhachHangId</code>, <code>GiayChiTietId</code>, <code>SoLuong</code>. Nếu DTO thực tế của endpoint khác, cần chỉnh tên trường cho khớp.</p>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm mt-3">
    <div class="card-header fw-bold">3. Cập nhật số lượng / xóa dòng giỏ hàng</div>
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label">GioHangChiTietId (GUID) để xóa</label>
                <input class="form-control" @bind="GioHangChiTietId" placeholder="GUID dòng chi tiết giỏ hàng" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Số lượng mới</label>
                <input class="form-control" type="number" min="1" @bind="NewQuantity" />
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button class="btn btn-warning" @onclick="UpdateQuantity">Cập nhật số lượng</button>
                <button class="btn btn-danger" @onclick="DeleteCartLine">Xóa dòng</button>
            </div>
        </div>
        <p class="small text-muted mt-2 mb-0">Cập nhật đang gọi <code>PUT /api/GioHangs/cap-nhat-so-luong?id=...&amp;soLuong=...</code>; xóa đang gọi <code>DELETE /api/GioHangChiTiet/{id}</code>.</p>
    </div>
</div>

<div class="card shadow-sm mt-3 mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span class="fw-bold">Kết quả API</span>
        <button class="btn btn-sm btn-outline-secondary" @onclick="ClearResult">Xóa kết quả</button>
    </div>
    <div class="card-body">
        @if (CartLines.Count > 0)
        {
            <div class="table-responsive mb-3">
                <table class="table table-striped table-hover align-middle">
                    <thead><tr><th>Tên giày</th><th>Size</th><th>Màu</th><th class="text-end">Đơn giá</th><th class="text-end">SL</th><th class="text-end">Thành tiền</th><th>GioHangChiTietId</th></tr></thead>
                    <tbody>
                    @foreach (var line in CartLines)
                    {
                        <tr>
                            <td>@(ReadString(line, "TenGiay") ?? ReadString(line, "tenGiay") ?? "—")</td>
                            <td>@(ReadString(line, "Size") ?? ReadString(line, "size") ?? "—")</td>
                            <td>@(ReadString(line, "MauSac") ?? ReadString(line, "mauSac") ?? "—")</td>
                            <td class="text-end">@FormatMoney(ReadDecimal(line, "Gia") ?? ReadDecimal(line, "gia"))</td>
                            <td class="text-end">@(ReadInt(line, "SoLuong") ?? ReadInt(line, "SoLuongSanPham") ?? ReadInt(line, "soLuong") ?? 0)</td>
                            <td class="text-end">@FormatMoney(ReadDecimal(line, "ThanhTien") ?? ReadDecimal(line, "thanhTien"))</td>
                            <td class="small text-break">@(ReadString(line, "GioHangChiTietId") ?? ReadString(line, "gioHangChiTietId") ?? "—")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        <pre class="bg-dark text-light p-3 rounded" style="white-space:pre-wrap;overflow-wrap:anywhere;min-height:80px">@ResultJson</pre>
    </div>
</div>

@code {
    private string KhachHangId = "";
    private string AddCustomerId = "";
    private string GioHangId = "";
    private string GiayChiTietId = "";
    private string GioHangChiTietId = "";
    private int AddQuantity = 1;
    private int NewQuantity = 1;
    private string ResultJson = "Chưa gọi API.";
    private string StatusMessage = "";
    private bool IsError;
    private List<JsonElement> CartLines = new();

    private async Task LoadAllCarts() => await CallApi(HttpMethod.Get, "api/GioHangs/GetAllGioHang");

    private async Task LoadCartByCustomer()
    {
        if (!Guid.TryParse(KhachHangId, out _)) { SetError("Vui lòng nhập KhachHangId hợp lệ."); return; }
        AddCustomerId = KhachHangId;
        await CallApi(HttpMethod.Get, $"api/GioHangs/khach-hang/{Uri.EscapeDataString(KhachHangId)}", true);
    }

    private async Task LoadCartDetails()
    {
        if (!Guid.TryParse(GioHangId, out _)) { SetError("Vui lòng nhập GioHangId hợp lệ."); return; }
        await CallApi(HttpMethod.Get, $"api/GioHangChiTiet/{Uri.EscapeDataString(GioHangId)}", true);
    }

    private async Task AddToCart()
    {
        if (!Guid.TryParse(AddCustomerId, out _) || !Guid.TryParse(GiayChiTietId, out _) || AddQuantity < 1)
        { SetError("Nhập KhachHangId, GiayChiTietId hợp lệ và số lượng từ 1 trở lên."); return; }
        var body = new { KhachHangId = AddCustomerId, GiayChiTietId, SoLuong = AddQuantity };
        await CallApi(HttpMethod.Post, "api/GioHangChiTiet/AddToCart", false, body);
    }

    private async Task UpdateQuantity()
    {
        if (!Guid.TryParse(GioHangChiTietId, out _) || NewQuantity < 1) { SetError("Nhập GioHangChiTietId hợp lệ và số lượng từ 1 trở lên."); return; }
        await CallApi(HttpMethod.Put, $"api/GioHangs/cap-nhat-so-luong?id={Uri.EscapeDataString(GioHangChiTietId)}&soLuong={NewQuantity}");
    }

    private async Task DeleteCartLine()
    {
        if (!Guid.TryParse(GioHangChiTietId, out _)) { SetError("Nhập GioHangChiTietId hợp lệ."); return; }
        await CallApi(HttpMethod.Delete, $"api/GioHangChiTiet/{Uri.EscapeDataString(GioHangChiTietId)}");
    }

    private async Task CallApi(HttpMethod method, string path, bool showAsLines = false, object? body = null)
    {
        try
        {
            using var request = new HttpRequestMessage(method, path);
            if (body is not null) request.Content = JsonContent.Create(body);
            using var response = await Http.SendAsync(request);
            var text = await response.Content.ReadAsStringAsync();
            ResultJson = PrettyJson(text);
            IsError = !response.IsSuccessStatusCode;
            StatusMessage = $"{(int)response.StatusCode} {response.ReasonPhrase} — {method} {path}";
            if (IsError) StatusMessage += " (API trả về lỗi; xem nội dung bên dưới).";
            CartLines.Clear();
            if (showAsLines && response.IsSuccessStatusCode) ExtractLines(text);
        }
        catch (Exception ex)
        {
            SetError($"Không gọi được API: {ex.Message}. Kiểm tra API có đang chạy và BaseAddress trong BlazorAdmin/Program.cs.");
            ResultJson = ex.ToString();
        }
    }

    private void ExtractLines(string json)
    {
        try
        {
            using var doc = JsonDocument.Parse(json);
            var root = doc.RootElement;
            JsonElement array = default;
            if (root.ValueKind == JsonValueKind.Array) array = root;
            else if (root.ValueKind == JsonValueKind.Object)
            {
                foreach (var p in root.EnumerateObject())
                    if (p.Value.ValueKind == JsonValueKind.Array && (p.Name.Contains("chiTiet", StringComparison.OrdinalIgnoreCase) || p.Name.Contains("DanhSach", StringComparison.OrdinalIgnoreCase) || p.Name.Contains("items", StringComparison.OrdinalIgnoreCase))) { array = p.Value; break; }
            }
            if (array.ValueKind == JsonValueKind.Array) foreach (var item in array.EnumerateArray()) CartLines.Add(item.Clone());
        }
        catch { }
    }

    private static string PrettyJson(string text)
    {
        try { using var doc = JsonDocument.Parse(text); return JsonSerializer.Serialize(doc.RootElement, new JsonSerializerOptions { WriteIndented = true }); }
        catch { return string.IsNullOrWhiteSpace(text) ? "(API không trả nội dung)" : text; }
    }
    private static string? ReadString(JsonElement e, string name) => e.ValueKind == JsonValueKind.Object && e.TryGetProperty(name, out var v) ? v.ToString() : null;
    private static decimal? ReadDecimal(JsonElement e, string name) => e.ValueKind == JsonValueKind.Object && e.TryGetProperty(name, out var v) && v.TryGetDecimal(out var n) ? n : null;
    private static int? ReadInt(JsonElement e, string name) => e.ValueKind == JsonValueKind.Object && e.TryGetProperty(name, out var v) && v.TryGetInt32(out var n) ? n : null;
    private static string FormatMoney(decimal? amount) => amount.HasValue ? amount.Value.ToString("N0") + " đ" : "—";
    private void ClearResult() { ResultJson = "Đã xóa kết quả."; StatusMessage = ""; IsError = false; CartLines.Clear(); }
    private void SetError(string message) { StatusMessage = message; IsError = true; }
}
